# Scholaria — configuration (copy to .env; .env is git-ignored).
# Everything runs locally; no API keys are needed.

# --- Network (keep on localhost) ---
RA_API_HOST=127.0.0.1
RA_API_PORT=8000
RA_FRONTEND_PORT=8501

# --- Ollama ---
RA_OLLAMA_URL=http://127.0.0.1:11434
RA_DEFAULT_MODEL=qwen3:4b-instruct-2507-q4_K_M
RA_FALLBACK_MODEL=qwen3:1.7b
RA_CONTEXT_LENGTH=4096
RA_MAX_TOKENS=1024
RA_TEMPERATURE=0.6
RA_KEEP_ALIVE=2m
RA_MAX_CONCURRENT_REQUESTS=1

# --- Limits ---
RA_MAX_UPLOAD_MB=25
RA_MAX_DATASET_MB=20
RA_HISTORY_MAX_MESSAGES=12

# --- Storage (relative to the project folder) ---
RA_STORAGE_DIR=storage
# RA_DATABASE_URL=sqlite:////absolute/path/to/research.db

RA_LOG_LEVEL=INFO
